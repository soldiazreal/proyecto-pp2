generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id         Int      @id @default(autoincrement())
  mesa       Int
  productos  Json
  total      Float
  estado     String   @default("Pendiente")
  createdAt  DateTime @default(now())
}