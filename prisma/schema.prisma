generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nombre    String
  password  String
  rol       String   @default("usuario")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mesa {
  id                Int        @id @default(autoincrement())
  numero            Int        @unique
  capacidad         Int?
  clientesActuales  Int        @default(0)
  consumoActual     Float      @default(0)
  duracionEstimada  Int?
  fechaCreacion     DateTime   @default(now())
  fechaModificacion DateTime   @updatedAt
  horaOcupacion     DateTime?
  meseroAsignado    String?
  estado            EstadoMesa @default(Disponible)
  pedidos           Pedido[]
}

model Plato {
  id          Int      @id @default(autoincrement())
  codigo      String
  nombre      String
  descripcion String
  precio      Float
  disponible  Boolean  @default(true)
  sinGluten   Boolean  @default(true)
  pedidos     Pedido[] 
}

model Pedido {
  id          Int      @id @default(autoincrement())
  estado      String   @default("Pendiente")
  createdAt   DateTime @default(now())
  mesaId      Int
  mesa        Mesa     @relation(fields: [mesaId], references: [id])
  platos      Plato[]  
}

enum EstadoMesa {
  Disponible
  Ocupada
  Reservada
  Mantenimiento
}
